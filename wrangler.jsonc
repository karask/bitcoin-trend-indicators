{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bitcoin-trend-indicators",
  "pages_build_output_dir": "./dist/cloudflare-pages",
  "compatibility_date": "2026-08-23",
  "d1_databases": [
    {
      "binding": "REGIME_DB",
      "database_name": "crypto-regime-data",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./drizzle"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "*"
  }
}
