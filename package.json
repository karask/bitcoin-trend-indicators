{
  "name": "bitcoin-regime-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "start": "next start",
    "test": "npm run test:unit && npm run build:pages && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern .next",
    "cf:d1:local": "wrangler d1 migrations apply crypto-regime-data --local --config=wrangler.jsonc",
    "cf:d1:remote": "wrangler d1 migrations apply crypto-regime-data --remote --config=wrangler.jsonc",
    "cf:seed:local": "node --experimental-strip-types scripts/seed-d1.ts --apply",
    "cf:seed:remote": "node --experimental-strip-types scripts/seed-d1.ts --all --apply --remote",
    "cf:deploy:pages": "npm run build:pages && wrangler pages deploy dist/cloudflare-pages --project-name=bitcoin-trend-indicators --branch=main",
    "cf:deploy:refresh": "wrangler deploy --config=wrangler.refresh.jsonc"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
