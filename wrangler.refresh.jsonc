{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crypto-regime-refresh",
  "main": "./worker/refresh.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "REGIME_DB",
      "database_name": "crypto-regime-data",
      "database_id": "72187f3b-5d53-4b16-a7e2-731437682eb5",
      "migrations_dir": "./drizzle"
    }
  ],
  "triggers": {
    "crons": ["15 0 * * *", "25 0 * * *", "35 0 * * *", "45 0 * * *", "55 0 * * *", "30 1 * * 2-6"]
  },
  "observability": {
    "enabled": true
  }
}
