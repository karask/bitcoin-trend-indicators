{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crypto-regime-refresh",
  "main": "./worker/refresh.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "REGIME_DB",
      "database_name": "crypto-regime-data",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./drizzle"
    }
  ],
  "triggers": {
    "crons": ["15 0 * * *", "25 0 * * *", "35 0 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
